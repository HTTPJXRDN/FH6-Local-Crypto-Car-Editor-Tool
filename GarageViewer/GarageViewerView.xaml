<UserControl x:Class="FH6LocalCryptoTool.GarageViewer.GarageViewerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#1D1D1F" Foreground="#F4F4F6" FontSize="12"
 Loaded="View_Loaded" AllowDrop="True" Drop="File_Drop" DragOver="File_DragOver">
 <UserControl.Resources>
  <LinearGradientBrush x:Key="GarageHeaderGradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3A3A3F" Offset="0"/><GradientStop Color="#303034" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="GaragePink" Color="#E8175D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#232326"/>
  <!-- Same rounded, arrow-free dark scrollbar treatment as Profile Editor. -->
  <Style x:Key="GarageScrollPageButton" TargetType="RepeatButton">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GarageScrollThumb" TargetType="Thumb">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
    <Border x:Name="ThumbBorder" Background="#FF565660" CornerRadius="4" Margin="2"/>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#FF6E6E7A"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource GaragePink}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}">
    <Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource GarageScrollPageButton}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource GarageScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource GarageScrollPageButton}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track>
   </Grid></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}">
     <Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource GarageScrollPageButton}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource GarageScrollThumb}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource GarageScrollPageButton}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton></Track>
    </Grid></ControlTemplate></Setter.Value></Setter>
   </Trigger></Style.Triggers>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="Background" Value="#333337"/><Setter Property="BorderBrush" Value="#454549"/>
   <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#E8175D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="Background" Value="#232326"/><Setter Property="CaretBrush" Value="#E8175D"/><Setter Property="BorderBrush" Value="#454549"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="GridSplitter"><Setter Property="Background" Value="#3C3C40"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8175D"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#9C9CA2"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="CheckBorder" Width="16" Height="16" CornerRadius="4" Background="#232326" BorderBrush="#565660" BorderThickness="1" Margin="0,0,6,0"><TextBlock x:Name="CheckMark" Text="✓" FontSize="12" Foreground="White" HorizontalAlignment="Center" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#E8175D"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#232326"/><Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="BorderBrush" Value="#454549"/><Setter Property="RowBackground" Value="#232326"/><Setter Property="AlternatingRowBackground" Value="#2C2C2F"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#3C3C40"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="RowHeight" Value="30"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="EnableRowVirtualization" Value="True"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#333337"/><Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="Padding" Value="6,3"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#663043"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#663043"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="Background" Value="#232326"/><Setter Property="BorderBrush" Value="#454549"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F4F4F6"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#663043"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <GroupStyle x:Key="GarageManufacturerGroup">
   <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
    <Expander Tag="Garage" Loaded="Manufacturer_Loaded" Foreground="#F4F4F6" IsExpanded="False" Margin="0,2,0,4">
     <Expander.Header><DockPanel MinWidth="200"><Button Content="Select removable" Click="SelectGarageManufacturer_Click" DockPanel.Dock="Right" Padding="8,3" Margin="12,0,4,0" ToolTip="Select all removable instances in this manufacturer group; protected/unknown cars are skipped."/><TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=")"/></TextBlock></DockPanel></Expander.Header>
     <ItemsPresenter/>
    </Expander>
   </ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
  </GroupStyle>
  <GroupStyle x:Key="CatalogManufacturerGroup">
   <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
    <Expander Tag="Catalog" Loaded="Manufacturer_Loaded" Foreground="#F4F4F6" IsExpanded="False" Margin="0,2,0,4">
     <Expander.Header><DockPanel MinWidth="150"><Button Content="Select all" Click="SelectCatalogManufacturer_Click" DockPanel.Dock="Right" Padding="6,3" Margin="8,0,0,0"/><TextBlock FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=")"/></TextBlock></DockPanel></Expander.Header>
     <ItemsPresenter/>
    </Expander>
   </ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
  </GroupStyle>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="WorkArea">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="GarageHeader" Background="{StaticResource GarageHeaderGradient}" BorderBrush="{StaticResource GaragePink}" BorderThickness="0,0,0,2" Padding="20,11" Margin="-12,-12,-12,18">
    <StackPanel><TextBlock FontSize="22" FontWeight="Bold"><Run Text="Garage" Foreground="#E8175D"/><Run Text=" Viewer"/></TextBlock><TextBlock Text="FH6 C_ProfileData • friendly car names • private working copy" Foreground="#9C9CA2" Margin="0,3,0,0"/></StackPanel>
   </Border>
   <StackPanel Grid.Row="1" Margin="0,0,0,10">
    <WrapPanel><Button Content="Load C_ProfileData…" Click="Load_Click"/><Button x:Name="ExportButton" Content="Export edited save…" Background="#E8175D" BorderBrush="#E8175D" Click="Export_Click" IsEnabled="False"/><Button x:Name="RevertButton" Content="Revert all edits" Click="Revert_Click" IsEnabled="False"/><Button Content="Load GameDB catalog…" Click="Catalog_Click" ToolTip="Optional: load your matching FH6 .slt / .sqlite for new or custom cars."/></WrapPanel>
    <TextBlock x:Name="LoadedPath" Text="Open or drop a C_ProfileData save here. The original file is never overwritten." Foreground="#9C9CA2" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TextBlock x:Name="CatalogLabel" Text="Loading embedded FH6 car names…" Foreground="#9C9CA2" Margin="0,3,0,0" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,5,0,0"><Button Content="Thumbnail cache folder…" Click="ThumbnailFolder_Click" Padding="8,4"/><TextBlock x:Name="ThumbnailCacheLabel" Text="Actual garage previews are read from the game's local cache." Foreground="#9C9CA2" TextWrapping="Wrap"/></WrapPanel>
   </StackPanel>
   <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="GarageSearch" TextChanged="Search_Changed" ToolTip="Search owned cars by name, year, car ID, or garage ID."/><TextBlock x:Name="CountLabel" Grid.Column="1" Text="No save loaded" Margin="12,0,0,0" Foreground="#9C9CA2"/></Grid>
   <Grid Grid.Row="3">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="250"/><ColumnDefinition Width="6"/><ColumnDefinition Width="275" MinWidth="180"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition x:Name="GarageListRow" Height="*" MinHeight="80"/><RowDefinition Height="Auto"/><RowDefinition x:Name="GarageFieldsRow" Height="1.4*" MinHeight="60"/></Grid.RowDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DataGrid x:Name="GarageGrid" RowHeight="64" SelectionMode="Extended" SelectionUnit="FullRow" IsSynchronizedWithCurrentItem="False" SelectionChanged="Selection_Changed" VirtualizingPanel.IsVirtualizingWhenGrouping="True"><DataGrid.GroupStyle><StaticResource ResourceKey="GarageManufacturerGroup"/></DataGrid.GroupStyle><DataGrid.Columns>
      <DataGridTemplateColumn Header="Preview" Width="105" MinWidth="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Height="56"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Loaded="Thumbnail_Loaded" DataContextChanged="Thumbnail_DataContextChanged" ToolTip="{Binding ThumbnailStatus}"/><TextBlock Text="Not cached" FontSize="10" Foreground="#9C9CA2" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Car" Binding="{Binding Name}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Car ID" Binding="{Binding CarId}" Width="65" MinWidth="65"/><DataGridTextColumn Header="Garage ID" Binding="{Binding Id}" Width="75" MinWidth="75"/><DataGridTextColumn Header="PI" Binding="{Binding PI}" Width="45" MinWidth="45"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140" MinWidth="140"/>
     </DataGrid.Columns></DataGrid>
     <TextBlock x:Name="SelectionDetails" Grid.Row="1" Text="Expand a manufacturer. Ctrl-click or Shift-click to select multiple cars." Foreground="#9C9CA2" TextWrapping="Wrap" Margin="0,8,0,8"/>
     <WrapPanel Grid.Row="2"><Button x:Name="RemoveButton" Content="Remove selected…" Click="Remove_Click" IsEnabled="False" Margin="0,0,6,4"/><Button x:Name="DuplicateButton" Content="Duplicate selected" Click="Duplicate_Click" IsEnabled="False" Margin="0,0,6,4"/><Button x:Name="CurrentButton" Content="Set as current car" Click="Current_Click" IsEnabled="False" Margin="0,0,6,4"/></WrapPanel>
     </Grid>
     <GridSplitter x:Name="GarageListHeightSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ToolTip="Drag up/down to resize the garage list and selected-car fields."/>
     <Expander x:Name="GarageFieldsExpander" Grid.Row="2" Header="SELECTED CAR • GARAGE FIELDS" Foreground="#E8175D" IsExpanded="True" Expanded="GarageFields_Expanded" Collapsed="GarageFields_Collapsed" Margin="0,8,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Border x:Name="CarDetailsPanel" Background="#232326" CornerRadius="6" Padding="8" Margin="0,5,0,0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="160">
       <StackPanel x:Name="CarFieldsArea" IsEnabled="False">
        <TextBlock x:Name="BatchFieldHint" Foreground="#9C9CA2" FontSize="11" Text="Check only the fields to replace on every selected car. Mixed values appear empty; unchecked fields remain unchanged." TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="144"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock x:Name="OriginalOwnerLabel" Text="Original Owner" Foreground="#9C9CA2"/><CheckBox x:Name="OwnerFieldToggle" Content="Original Owner" Visibility="Collapsed" Checked="BatchFieldToggle_Changed" Unchecked="BatchFieldToggle_Changed"/>
         <TextBox x:Name="OriginalOwnerBox" Grid.Column="1" TextChanged="CarField_Changed" MaxLength="256" Margin="0,0,0,4" ToolTip="Career_Garage.OriginalOwner text label; does not change account identity."/>
         <TextBlock x:Name="OwnerMixedText" Grid.Column="1" Text="Mixed — unchanged" Foreground="#9C9CA2" IsHitTestVisible="False" Margin="8,0,0,4" Visibility="Collapsed"/>
         <TextBlock x:Name="DistanceDrivenLabel" Grid.Row="1" Text="Distance driven" Foreground="#9C9CA2"/><CheckBox x:Name="DistanceFieldToggle" Grid.Row="1" Content="Distance driven" Visibility="Collapsed" Checked="BatchFieldToggle_Changed" Unchecked="BatchFieldToggle_Changed"/>
         <TextBox x:Name="DistanceDrivenBox" Grid.Row="1" Grid.Column="1" TextChanged="CarField_Changed" Margin="0,0,0,4" ToolTip="Career_Garage.DistanceDriven, raw DB units. Non-negative whole number, up to 2147483647."/>
         <TextBlock x:Name="DistanceMixedText" Grid.Row="1" Grid.Column="1" Text="Mixed — unchanged" Foreground="#9C9CA2" IsHitTestVisible="False" Margin="8,0,0,4" Visibility="Collapsed"/>
         <TextBlock x:Name="TopSpeedLabel" Grid.Row="2" Text="Top speed" Foreground="#9C9CA2"/><CheckBox x:Name="SpeedFieldToggle" Grid.Row="2" Content="Top speed" Visibility="Collapsed" Checked="BatchFieldToggle_Changed" Unchecked="BatchFieldToggle_Changed"/>
         <TextBox x:Name="TopSpeedBox" Grid.Row="2" Grid.Column="1" TextChanged="CarField_Changed" ToolTip="Career_Garage.TopSpeed, raw DB units. Non-negative decimal; dot or comma accepted."/>
         <TextBlock x:Name="SpeedMixedText" Grid.Row="2" Grid.Column="1" Text="Mixed — unchanged" Foreground="#9C9CA2" IsHitTestVisible="False" Margin="8,0,0,0" Visibility="Collapsed"/>
        </Grid>
        <Button x:Name="ApplyCarFieldsButton" Content="Apply car fields" Click="ApplyCarFields_Click" IsEnabled="False" HorizontalAlignment="Left" Padding="10,5" Margin="0,6,0,0"/>
       </StackPanel>
       </ScrollViewer>
       <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Image x:Name="SelectedCarPreview" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <TextBlock x:Name="SelectedPreviewPlaceholder" Text="Select one car for its preview" Foreground="#9C9CA2" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock x:Name="SelectedPreviewStatus" Grid.Row="1" FontSize="10" Foreground="#9C9CA2" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,3,0,0"/>
       </Grid>
      </Grid></Border>
     </Expander>
    </Grid>
    <GridSplitter x:Name="GarageListWidthSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" ToolTip="Drag left/right to resize the garage list and stock-car catalog."/>
    <Grid Grid.Column="2" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="ADD STOCK CARS • CTRL / SHIFT SELECT" Foreground="#E8175D" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>
     <TextBox x:Name="CatalogSearch" Grid.Row="1" TextChanged="CatalogSearch_Changed" ToolTip="Search available stock cars by name, year, or ID." Margin="0,0,0,8"/>
     <ListBox x:Name="CatalogList" Grid.Row="2" DisplayMemberPath="DisplayName" SelectionMode="Extended" SelectionChanged="Selection_Changed" VirtualizingPanel.IsVirtualizingWhenGrouping="True"><ListBox.GroupStyle><StaticResource ResourceKey="CatalogManufacturerGroup"/></ListBox.GroupStyle></ListBox>
     <Button x:Name="AddButton" Grid.Row="3" Content="Add selected cars" Click="Add_Click" IsEnabled="False" Margin="0,8,0,0"/>
    </Grid>
   </Grid>
   <Border Grid.Row="4" Background="#232326" CornerRadius="6" Padding="10" Margin="0,12,0,0"><TextBlock Text="Back up your entire save and close the game before installing an exported copy. Current/pending cars and barn-find VINs are protected. Adding cars does not grant collection rewards or update career progress. Use a matching FH6 GameDB for stock parts; FM saves are not supported." Foreground="#9C9CA2" TextWrapping="Wrap"/></Border>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock x:Name="CarFieldHelp" Text="Select one garage car to edit its fields." FontSize="11" TextWrapping="Wrap" Foreground="#9C9CA2"/><TextBlock x:Name="StatusText" Text="Ready." Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#9C9CA2"/></StackPanel>
 </Grid>
</UserControl>
