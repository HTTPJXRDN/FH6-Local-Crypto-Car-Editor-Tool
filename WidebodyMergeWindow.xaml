<Window x:Class="FH6LocalCryptoTool.WidebodyMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import one car's widebodies" Width="690" Height="430" MinWidth="570" MinHeight="340"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF1D1D1F" Foreground="#FFF4F4F6">
    <Window.Resources>
        <SolidColorBrush x:Key="Pink" Color="#FFE8175D"/>
        <SolidColorBrush x:Key="Dim" Color="#FF9C9CA2"/>
        <SolidColorBrush x:Key="Line" Color="#FF3C3C40"/>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF4F4F6"/>
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Pink}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Background="#FF242427">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#FF333337" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="IMPORT WIDEBODIES FROM ONE CAR" Foreground="{StaticResource Pink}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="16,0"/>
                <Button Grid.Column="1" Content="×" Width="42" FontSize="20" Background="Transparent"
                        Foreground="{StaticResource Dim}" BorderThickness="0" Click="Cancel_Click"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="16,14,16,10">
                <TextBlock x:Name="SourceText" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Choose a donor car. This copies its new widebody rows and dependencies into a NEW database; the base and donor stay untouched."
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <CheckBox x:Name="OverrideConflicts" Margin="0,10,0,0" Foreground="{StaticResource Pink}"
                          Content="Override conflicting rows for the selected car" Checked="Override_Changed"
                          Unchecked="Override_Changed"/>
                <TextBlock Foreground="{StaticResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="22,3,0,0"
                           Text="Off: import only new kits and stop on conflicting IDs. On: donor rows replace matching bodykit, part, wing, preset, and aero rows for this car. Shared aero IDs can affect other cars."/>
            </StackPanel>
            <ListBox Grid.Row="2" x:Name="CarChoices" Margin="16,0,16,0" FontSize="13" Padding="7"
                     Background="#FF1F1F22" Foreground="#FFF4F4F6" BorderBrush="{StaticResource Line}"
                     SelectionChanged="CarChoices_SelectionChanged"/>
            <Grid Grid.Row="3" Margin="16,12,16,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="The original base and donor files are never overwritten."/>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource ButtonStyle}"
                        Margin="12,0,8,0" Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="ImportButton" Content="Import selected car" IsEnabled="False"
                        Style="{StaticResource ButtonStyle}" BorderBrush="{StaticResource Pink}" Click="Import_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
