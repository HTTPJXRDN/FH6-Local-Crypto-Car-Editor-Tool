<UserControl x:Class="FH6AnimationSwap.AnimationSwapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppGrad}"
             TextOptions.TextFormattingMode="Ideal"
             UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="AnimationPairButton" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="#FF313135"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="PairBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="14,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PairBorder" Property="BorderBrush" Value="{DynamicResource Pink2}"/>
                <Setter TargetName="PairBorder" Property="Background" Value="#FF38383D"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PairBorder" Property="BorderBrush" Value="{DynamicResource Pink}"/>
                <Setter TargetName="PairBorder" Property="Background" Value="#44E8175D"/>
                <Setter Property="Foreground" Value="{DynamicResource Pink}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AnimationListView" TargetType="ListView">
      <Setter Property="Background" Value="{DynamicResource Card2}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="AnimationListItem" TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="4,5" Margin="1">
              <GridViewRowPresenter Content="{TemplateBinding Content}"
                                    Columns="{TemplateBinding GridView.ColumnCollection}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#33E8175D"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#66E8175D"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AnimationColumnHeader" TargetType="GridViewColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
      <Setter Property="Background" Value="#FF303034"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="7,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,18,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Margin="-24,-18,-24,18"
            Background="{DynamicResource CardHeadGrad}" Padding="20,11"
            BorderBrush="{DynamicResource PinkAccentLine}" BorderThickness="0,0,0,2">
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="Bold">
          <Run Text="Animation" Foreground="{DynamicResource Pink}"/><Run Text=" Swap"/>
        </TextBlock>
        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Dim}" FontSize="12" TextWrapping="Wrap"
                   Text="Swap complete door motions and other CLIPD animation channels, edit full car ZIPs, and apply the database-stance compatibility patch."/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{DynamicResource PremiumCard}" Padding="16,13" Margin="0,0,0,14"
            AllowDrop="True" DragOver="AnyDrag" Drop="TargetDrop">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Viewbox Grid.Column="0" Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
          <Path Data="M4 6 H10 L12 9 H22 V21 H4 Z M8 13 H18 M13 10 V18"
                Stroke="{DynamicResource Pink}" StrokeThickness="1.6" Fill="Transparent"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Viewbox>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="DROP A COMPLETE CAR ZIP OR CARCLIPS_&lt;ID&gt;.CLIPD"
                     Foreground="{DynamicResource Pink}" FontWeight="Bold" FontSize="12"/>
          <TextBlock x:Name="TargetName" Text="No animation file loaded"
                     Foreground="{DynamicResource Ink}" FontSize="14" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="2" Content="Browse…" Style="{DynamicResource PinkButton}"
                MinWidth="104" Margin="14,0,0,0" Click="Browse_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.9*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{DynamicResource PremiumCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource CardHeadGrad}" Padding="14,10"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
            <StackPanel>
              <TextBlock Text="1  PICK ANIMATION TARGET" Foreground="{DynamicResource Pink}" FontWeight="Bold" FontSize="12"/>
              <TextBlock Text="Front and rear door pairs can use different donor cars."
                         Foreground="{DynamicResource Dim}" FontSize="11.5" Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
          <Grid Grid.Row="1" Margin="14,12,6,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" x:Name="FrontBtn" Style="{StaticResource AnimationPairButton}"
                          Content="FRONT DOORS" Tag="front" Click="Pair_Click"/>
            <ToggleButton Grid.Column="1" x:Name="RearBtn" Style="{StaticResource AnimationPairButton}"
                          Content="REAR DOORS" Tag="rear" Click="Pair_Click"/>
          </Grid>
          <Expander Grid.Row="2" x:Name="OtherExpander" Margin="14,0,14,12" IsExpanded="False"
                    Header="Other channels (experimental)" Foreground="{DynamicResource Ink}">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Foreground="#FFFFC65A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="Direction is not verified for hood, trunk, wing, and other non-door channels. The structural save checks still apply."/>
              <ListView Grid.Row="1" x:Name="OtherList" MinHeight="150" SelectionMode="Single"
                        SelectionChanged="Other_Changed" Style="{StaticResource AnimationListView}"
                        ItemContainerStyle="{StaticResource AnimationListItem}">
                <ListView.View>
                  <GridView ColumnHeaderContainerStyle="{StaticResource AnimationColumnHeader}">
                    <GridViewColumn Header="Channel" Width="145" DisplayMemberBinding="{Binding Label}"/>
                    <GridViewColumn Header="Struct" Width="64" DisplayMemberBinding="{Binding Sig}"/>
                    <GridViewColumn Header="Size" Width="54" DisplayMemberBinding="{Binding Size}"/>
                    <GridViewColumn Header="Status" Width="135" DisplayMemberBinding="{Binding Status}"/>
                  </GridView>
                </ListView.View>
              </ListView>
            </Grid>
          </Expander>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{DynamicResource PremiumCard}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource CardHeadGrad}" Padding="14,10"
                  BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
            <StackPanel>
              <TextBlock Text="2  CHOOSE DONOR" Foreground="{DynamicResource Pink}" FontWeight="Bold" FontSize="12"/>
              <TextBlock x:Name="DonorHeader" Text="Load a car, then select Front or Rear doors."
                         Foreground="{DynamicResource Dim}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <ListView Grid.Row="1" x:Name="DonorList" Margin="12" SelectionMode="Single"
                    Style="{StaticResource AnimationListView}"
                    ItemContainerStyle="{StaticResource AnimationListItem}">
            <ListView.View>
              <GridView ColumnHeaderContainerStyle="{StaticResource AnimationColumnHeader}">
                <GridViewColumn Header="Motion" Width="66" DisplayMemberBinding="{Binding Motion}"/>
                <GridViewColumn Header="From car" Width="235" DisplayMemberBinding="{Binding CarName}"/>
                <GridViewColumn Header="Struct" Width="68" DisplayMemberBinding="{Binding Sig}"/>
                <GridViewColumn Header="Size" Width="58" DisplayMemberBinding="{Binding Size}"/>
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <Expander Grid.Row="3" Margin="0,12,0,0" Foreground="{DynamicResource Ink}"
              Header="MANAGE CLIPD CHANNELS — add or remove complete animations (advanced)">
      <Border Style="{DynamicResource PremiumCard}" Padding="14,12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Foreground="{DynamicResource Dim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                     Text="Import selected channels from another CLIPD or car ZIP, or remove selected channels. Existing channel IDs are kept; imports do not overwrite them. New parts may also need matching skeleton bones and Mojo events. Nothing is written until Save As."/>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="THIS CAR" Foreground="{DynamicResource Pink}" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
              <ListView Grid.Row="1" x:Name="AllChannelList" Height="155" SelectionMode="Extended"
                        Style="{StaticResource AnimationListView}" ItemContainerStyle="{StaticResource AnimationListItem}">
                <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource AnimationColumnHeader}">
                  <GridViewColumn Header="Animation" Width="160" DisplayMemberBinding="{Binding Label}"/>
                  <GridViewColumn Header="ID" Width="90" DisplayMemberBinding="{Binding Id}"/>
                  <GridViewColumn Header="Size" Width="55" DisplayMemberBinding="{Binding Size}"/>
                </GridView></ListView.View>
              </ListView>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Adjust start/end…" Style="{DynamicResource PinkButton}" Height="34"
                        Click="EditEndpoints_Click"/>
                <Button Content="Remove selected" Style="{DynamicResource GhostButton}" Height="34"
                        Margin="8,0,0,0" Click="RemoveChannels_Click"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="DONOR" Foreground="{DynamicResource Pink}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="DonorChannelName" Text="No donor loaded" Foreground="{DynamicResource Dim}"
                           FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <ListView Grid.Row="1" x:Name="DonorChannelList" Height="155" SelectionMode="Extended"
                        Style="{StaticResource AnimationListView}" ItemContainerStyle="{StaticResource AnimationListItem}">
                <ListView.View><GridView ColumnHeaderContainerStyle="{StaticResource AnimationColumnHeader}">
                  <GridViewColumn Header="Animation" Width="160" DisplayMemberBinding="{Binding Label}"/>
                  <GridViewColumn Header="ID" Width="90" DisplayMemberBinding="{Binding Id}"/>
                  <GridViewColumn Header="Size" Width="55" DisplayMemberBinding="{Binding Size}"/>
                </GridView></ListView.View>
              </ListView>
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Load donor…" Style="{DynamicResource GhostButton}" Height="34"
                        Click="LoadChannelDonor_Click"/>
                <Button Content="Add selected" Style="{DynamicResource PinkButton}" Height="34"
                        Margin="8,0,0,0" Click="AddChannels_Click"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Expander>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Apply donor → selected animation" Style="{DynamicResource PinkFilled}"
              Height="42" HorizontalAlignment="Stretch" Click="Apply_Click"/>
      <Button Grid.Column="1" x:Name="DbStanceFixBtn" Content="Fix DB ride height / spacers"
              Style="{DynamicResource PinkButton}" Height="42" Margin="10,0,0,0"
              Click="DbStanceFix_Click" IsEnabled="False"
              ToolTip="Removes authored suspension channels so database ride-height and track-width changes can render."/>
      <Button Grid.Column="2" Content="Reset" Style="{DynamicResource GhostButton}"
              Height="42" Margin="10,0,0,0" Click="Reset_Click"/>
      <Button Grid.Column="3" Content="Save As…" Style="{DynamicResource PinkButton}"
              Height="42" Margin="10,0,0,0" Click="Save_Click"/>
    </Grid>

    <Border Grid.Row="5" Style="{DynamicResource PremiumCard}" Margin="0,12,0,0" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource Pink}" Margin="0,0,10,0"/>
        <TextBlock Grid.Column="1" x:Name="Status" Foreground="{DynamicResource Dim}" FontSize="12"
                   TextWrapping="Wrap"
                   Text="Load a complete car ZIP or raw CLIPD. Apply swaps or the stance compatibility fix, then save to a new file."/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
