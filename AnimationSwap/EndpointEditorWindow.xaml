<Window x:Class="FH6AnimationSwap.EndpointEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animation endpoints" Width="700" Height="620" MinWidth="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="#FF1D1D1F" Foreground="#FFF4F4F6"
        Icon="/FH6ModStudio;component/Assets/ICO/dbtool_icon.ico">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF202023"/>
      <Setter Property="Foreground" Value="#FFF4F4F6"/>
      <Setter Property="BorderBrush" Value="#FF49494F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,3,8,0"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="#FFE8175D"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#FF353539"/>
    </Style>
    <Style x:Key="TrackToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Box" Background="#FF29292D" BorderBrush="#FF49494F" BorderThickness="1" CornerRadius="6">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                  TextElement.Foreground="#FFF4F4F6" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Path Grid.Column="1" Data="M0 0 L5 5 L10 0" Stroke="#FFE8175D" StrokeThickness="2"
                      Margin="0,0,12,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#FFFF2E70"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#FFF4F4F6"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBox" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBox" Property="Background" Value="#FF44272F"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBox" Property="Background" Value="#FF55303C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#FFF4F4F6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource TrackToggle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#FF29292D" BorderBrush="#FF49494F" BorderThickness="1"
                        CornerRadius="6" Margin="0,3,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="#FF202023" BorderBrush="#FF49494F" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="2"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FF161618" MouseLeftButtonDown="Header_MouseDown">
        <Grid>
          <TextBlock Text="FH6 LOCAL MOD TOOL  /  ANIMATION ENDPOINTS" Foreground="#FF9C9CA2"
                     FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0,0,0"/>
          <Button Content="✕" HorizontalAlignment="Right" Width="42" Background="Transparent"
                  Foreground="#FFF4F4F6" BorderThickness="0" Click="Cancel_Click" Cursor="Hand"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="#FFE8175D"/>
      <Grid Grid.Row="2" Margin="22,18,22,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Adjust animation endpoints" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock x:Name="ChannelTitle" Foreground="#FFFF2E70" FontWeight="SemiBold" Margin="0,5,0,0"/>
          <TextBlock Foreground="#FFB5B5BA" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="These are the loaded animation's current endpoint values. Change a value to move that endpoint; untouched values stay as they are. The tool blends the change through this animation channel."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Track / bone" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="TrackBox" Width="430" Height="32" SelectionChanged="TrackBox_SelectionChanged"/>
          </StackPanel>
          <CheckBox x:Name="WholeTrack" Content="Move the entire track by the START position offset"
                    Foreground="#FFF4F4F6" Margin="0,12,0,0"
                    Checked="WholeTrack_Changed" Unchecked="WholeTrack_Changed"/>
          <TextBlock Foreground="#FFB5B5BA" TextWrapping="Wrap" Margin="0,5,0,0"
                     Text="For needles, select the speedometer or tachometer animation and its matching bone. A bone can also appear in another animation; this changes only the selected channel. Whole-track mode leaves rotation alone and keeps constant tracks the same size when possible."/>
        </StackPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="#FF2D2D31" BorderBrush="#FF49494F" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="START OF ANIMATION" Foreground="#FFE8175D" FontWeight="Bold"/>
                <TextBlock Text="Position (metres)" Foreground="#FFB5B5BA" Margin="0,10,0,0"/>
                <UniformGrid Columns="3" Margin="0,4,0,0">
                  <StackPanel><TextBlock Text="X"/><TextBox x:Name="StartX" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Y"/><TextBox x:Name="StartY" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Z"/><TextBox x:Name="StartZ" Text="0"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="Rotation (degrees)" Foreground="#FFB5B5BA" Margin="0,12,0,0"/>
                <UniformGrid Columns="3" Margin="0,4,0,0">
                  <StackPanel><TextBlock Text="X"/><TextBox x:Name="StartRX" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Y"/><TextBox x:Name="StartRY" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Z"/><TextBox x:Name="StartRZ" Text="0"/></StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
            <Border Background="#FF2D2D31" BorderBrush="#FF49494F" BorderThickness="1"
                    CornerRadius="8" Padding="14">
              <StackPanel>
                <TextBlock Text="END OF ANIMATION" Foreground="#FFE8175D" FontWeight="Bold"/>
                <TextBlock Text="Position (metres)" Foreground="#FFB5B5BA" Margin="0,10,0,0"/>
                <UniformGrid Columns="3" Margin="0,4,0,0">
                  <StackPanel><TextBlock Text="X"/><TextBox x:Name="EndX" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Y"/><TextBox x:Name="EndY" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Z"/><TextBox x:Name="EndZ" Text="0"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="Rotation (degrees)" Foreground="#FFB5B5BA" Margin="0,12,0,0"/>
                <UniformGrid Columns="3" Margin="0,4,0,0">
                  <StackPanel><TextBlock Text="X"/><TextBox x:Name="EndRX" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Y"/><TextBox x:Name="EndRY" Text="0"/></StackPanel>
                  <StackPanel><TextBlock Text="Z"/><TextBox x:Name="EndRZ" Text="0"/></StackPanel>
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
          <Button Content="Apply to loaded CLIPD" Style="{StaticResource ActionButton}" Click="Apply_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
