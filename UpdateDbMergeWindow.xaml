<Window x:Class="FH6LocalCryptoTool.UpdateDbMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge updated DB" Width="710" Height="490" MinWidth="590" MinHeight="440"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#FF1D1D1F" Foreground="#FFF4F4F6">
    <Window.Resources>
        <SolidColorBrush x:Key="Pink" Color="#FFE8175D"/>
        <SolidColorBrush x:Key="Dim" Color="#FF9C9CA2"/>
        <SolidColorBrush x:Key="Line" Color="#FF3C3C40"/>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF4F4F6"/>
            <Setter Property="Background" Value="#FF333337"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Pink}"/></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Background="#FF242427">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#FF333337" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="MERGE UPDATED DB" Foreground="{StaticResource Pink}" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0"/>
                <Button Grid.Column="1" Content="×" Width="42" FontSize="20" Background="Transparent"
                        Foreground="{StaticResource Dim}" BorderThickness="0" Click="Cancel_Click"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="16,15,16,12">
                <TextBlock x:Name="SourcesText" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource Pink}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBlock Text="The result starts from the clean updated DB. Your old modded DB is compared with its version-matched clean baseline. Only your additions, edited fields and deliberate deletions are applied. New update content and the new VersionInfo are kept."
                           TextWrapping="Wrap" Margin="0,9,0,0"/>
                <TextBlock Text="Important: your edits win when both you and the update changed the same field. Deliberately deleted old keys are removed even if the update changed them. Review and test the output before installing it; a matching version stamp does not prove an external baseline is unmodified."
                           Foreground="{StaticResource Pink}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
            <TextBox Grid.Row="2" x:Name="DetailsText" Margin="16,0,16,0" Padding="10" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#FF1F1F22" Foreground="#FFF4F4F6" BorderBrush="{StaticResource Line}"/>
            <Grid Grid.Row="3" Margin="16,12,16,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SafetyText" Foreground="{StaticResource Dim}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource ButtonStyle}" Margin="12,0,8,0" Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="MergeButton" Content="Create updated DB" Style="{StaticResource ButtonStyle}"
                        BorderBrush="{StaticResource Pink}" Click="Merge_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
