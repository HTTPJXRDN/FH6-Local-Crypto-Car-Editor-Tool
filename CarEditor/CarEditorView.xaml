<UserControl x:Class="FH6CarEditor.CarEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1D1D1F"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
  <UserControl.Resources>

    <!-- ===== Application palette ===== -->
    <SolidColorBrush x:Key="WinBg"   Color="#FF1D1D1F"/>
    <SolidColorBrush x:Key="Card"    Color="#FF2C2C2F"/>
    <SolidColorBrush x:Key="Card2"   Color="#FF232326"/>
    <SolidColorBrush x:Key="CardHead" Color="#FF333337"/>
    <SolidColorBrush x:Key="Line"    Color="#FF3C3C40"/>
    <SolidColorBrush x:Key="Hairline" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Ink"     Color="#FFF4F4F6"/>
    <SolidColorBrush x:Key="Dim"     Color="#FF9C9CA2"/>
    <SolidColorBrush x:Key="Faint"   Color="#FF6E6E74"/>
    <SolidColorBrush x:Key="Pink"    Color="#FFE8175D"/>
    <SolidColorBrush x:Key="Pink2"   Color="#FFCC527A"/>

    <LinearGradientBrush x:Key="AppGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF212123" Offset="0"/>
      <GradientStop Color="#FF191919" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF303034" Offset="0"/>
      <GradientStop Color="#FF29292C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHeadGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF3A3A3F" Offset="0"/>
      <GradientStop Color="#FF303034" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFF2E70" Offset="0"/>
      <GradientStop Color="#FFE8175D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkGradHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFF4A84" Offset="0"/>
      <GradientStop Color="#FFF02765" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkAccentLine" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFE8175D" Offset="0"/>
      <GradientStop Color="#66E8175D" Offset="0.55"/>
      <GradientStop Color="#00E8175D" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Direction="270"
                      Color="#FF000000" Opacity="0.36"/>

    <!-- ===== Card container ===== -->
    <Style x:Key="CardBorder" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardGrad}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- section header strip (rounded top) -->
    <Style x:Key="CardHeadStrip" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardHeadGrad}"/>
      <Setter Property="CornerRadius" Value="12,12,0,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Pink}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
      <Setter Property="Margin" Value="0,7,0,2"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Dim}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Ghost button (subtle utility) ===== -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#FF313135"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink2}"/>
                <Setter TargetName="b" Property="Background" Value="#FF38383D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Pink-outlined button ===== -->
    <Style x:Key="PinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Foreground" Value="{StaticResource Pink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Pink}"/>
      <Setter Property="Background" Value="#22E8175D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#44E8175D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF4A2530"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Pink filled button (primary action) ===== -->
    <Style x:Key="PinkFilled" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource PinkGrad}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#FFE8175D" Opacity="0.42"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource PinkGradHover}"/>
                <Setter TargetName="b" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FFE8175D" Opacity="0.68"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFC9124E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/>
                <Setter TargetName="b" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Dark TextBox ===== -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Pink}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#FF202023"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink}"/>
                <Setter TargetName="b" Property="Background" Value="#FF242428"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small numeric field -->
    <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource Input}">
      <Setter Property="Width" Value="62"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>

    <!-- ===== Dark ListBox ===== -->
    <Style x:Key="DarkList" TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource Card2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
              <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="5"
                    Padding="{TemplateBinding Padding}" Margin="0,1">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF3A3A3A"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Pink}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Dark ComboBox ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="{StaticResource Card2}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem,
                        RelativeSource={RelativeSource AncestorType=ComboBox}}"
                        TextElement.Foreground="{StaticResource Ink}"
                        Margin="12,0,0,0" VerticalAlignment="Center"/>
                <Viewbox Grid.Column="1" Width="14" Height="14" Margin="0,0,12,0">
                  <Path Data="M6 9 L12 15 L18 9" Stroke="{StaticResource Pink}"
                        StrokeThickness="2.2" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{StaticResource Ink}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF44272F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                         RelativeSource={RelativeSource TemplatedParent}}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                        BorderThickness="1" CornerRadius="7" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="260">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Pink CheckBox ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="5"
                      Background="Transparent" BorderBrush="{StaticResource Line}"
                      BorderThickness="2" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14">
                  <Path x:Name="tick" Data="M4 8 L7 11 L12 4" Stroke="White"
                        StrokeThickness="2" StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Viewbox>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{StaticResource Pink}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Pink}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Pink2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Dark ScrollBar ===== -->
    <Style x:Key="ScrollNubHidden" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="#FF565660" CornerRadius="4" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#FF6E6E7A"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="t" Property="Background" Value="{StaticResource Pink2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Dropdown toggle (button that opens a checkbox popup) ===== -->
    <Style x:Key="DropdownToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="{StaticResource Card2}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="7" Padding="10,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                <Viewbox Grid.Column="1" Width="13" Height="13" Margin="8,0,0,0">
                  <Path Data="M6 9 L12 15 L18 9" Stroke="{StaticResource Pink}" StrokeThickness="2.2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </UserControl.Resources>

  <Grid TextElement.Foreground="{StaticResource Ink}" Background="{StaticResource AppGrad}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===================== HEADER ===================== -->
    <Border Grid.Row="0" Background="{StaticResource CardHeadGrad}" Padding="20,11"
            BorderBrush="{StaticResource PinkAccentLine}" BorderThickness="0,0,0,2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="Bold">
            <Run Text="FH6" Foreground="{StaticResource Pink}"/><Run Text=" Car Editor"/>
          </TextBlock>
          <TextBlock x:Name="Status" Text="no database loaded — Load a DB to begin"
                     Foreground="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="📂  Load DB" Style="{StaticResource GhostButton}" Click="LoadDb_Click" Margin="0,0,8,0"/>
          <Button x:Name="ReloadBtn" Content="↺  Reload" Style="{StaticResource GhostButton}"
                  IsEnabled="False" Click="Reload_Click" Margin="0,0,14,0"/>
          <TextBlock Text="Output" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="OutName" Style="{StaticResource Input}" Width="240"
                   Text="gamedbRC_modified.sqlite" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Button x:Name="ExportBtn" Content="⬇  Export DB" Style="{StaticResource PinkFilled}"
                  IsEnabled="False" Click="Export_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== BODY ===================== -->
    <Grid Grid.Row="1" Margin="18">
      <!-- Proportional columns so the center never collapses on a narrow / RDP window.
           MaxWidth caps the side cards on big monitors; MinWidth keeps them usable when tight. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*" MinWidth="150" MaxWidth="360"/>
        <ColumnDefinition Width="2*" MinWidth="200"/>
        <ColumnDefinition Width="1.35*" MinWidth="150" MaxWidth="380"/>
      </Grid.ColumnDefinitions>

      <!-- ===== LEFT: pick a car ===== -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource CardHeadStrip}">
            <TextBlock Style="{StaticResource CardTitle}" Text="PICK A CAR"/>
          </Border>
          <Grid Grid.Row="1" Margin="12,10,12,0" HorizontalAlignment="Left">
            <ToggleButton x:Name="FilterToggle" Style="{StaticResource DropdownToggle}" Content="All types" MinWidth="170"/>
            <Popup IsOpen="{Binding IsChecked, ElementName=FilterToggle}" StaysOpen="False"
                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      CornerRadius="7" Margin="0,4,0,0" Padding="12,8">
                <StackPanel>
                  <TextBlock Text="Show types" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,0,0,6"/>
                  <CheckBox x:Name="FiltICE" Content="ICE" IsChecked="True" Margin="0,3" Checked="Filt_Changed" Unchecked="Filt_Changed"/>
                  <CheckBox x:Name="FiltEV" Content="EV" IsChecked="True" Margin="0,3" Checked="Filt_Changed" Unchecked="Filt_Changed"/>
                  <CheckBox x:Name="FiltConv" Content="EV→ICE" IsChecked="True" Margin="0,3" Checked="Filt_Changed" Unchecked="Filt_Changed"/>
                  <CheckBox x:Name="FiltIceEv" Content="ICE→EV" IsChecked="True" Margin="0,3" Checked="Filt_Changed" Unchecked="Filt_Changed"/>
                  <Border Height="1" Background="{StaticResource Line}" Margin="0,7,0,5"/>
                  <CheckBox x:Name="FiltBodykit" Content="Bodykit preset only" Margin="0,3"
                            Checked="Filt_Changed" Unchecked="Filt_Changed"
                            ToolTip="Only show cars whose preset package selects a non-stock car body."/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <Grid Grid.Row="2" Margin="12,10,12,0">
            <TextBox x:Name="CarSearch" Style="{StaticResource Input}" TextChanged="CarSearch_Changed"/>
            <TextBlock x:Name="CarSearchPh" Text="search: MissionR, NVision, Supra…"
                       Foreground="{StaticResource Dim}" IsHitTestVisible="False"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ListBox x:Name="CarList" Grid.Row="3" Style="{StaticResource DarkList}"
                   Margin="12,10,12,0" SelectionChanged="CarList_Changed"/>
          <Border Grid.Row="4" Margin="12,10,12,10" Background="{StaticResource Card2}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,8">
            <TextBlock x:Name="CarInfo" FontFamily="Consolas" FontSize="12"
                       Foreground="{StaticResource Ink}" MinHeight="112"/>
          </Border>
          <StackPanel Grid.Row="5" Margin="12,0,12,12">
            <CheckBox x:Name="OptAutoshow" Content="Available in Autoshow" IsEnabled="False"
                      Margin="0,0,0,8" Click="Autoshow_Click"
                      ToolTip="Toggles Data_Car.NotAvailableInAutoshow for the selected car — applies instantly."/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="AddFeBtn" Grid.Column="0" Content="＋ FE cars" Style="{StaticResource GhostButton}"
                      IsEnabled="False" Padding="6,5" FontSize="10.5" Margin="0,0,4,0" Click="AddFe_Click"
                      ToolTip="Make every Forza Edition car available in the Autoshow."/>
              <Button x:Name="RemoveFeBtn" Grid.Column="1" Content="− FE cars" Style="{StaticResource GhostButton}"
                      IsEnabled="False" Padding="6,5" FontSize="10.5" Margin="4,0,0,0" Click="RemoveFe_Click"
                      ToolTip="Hide every Forza Edition car from the Autoshow, including FE cars sold there by default."/>
            </Grid>
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="AllPriceOneBtn" Grid.Column="0" Content="All cars = 1 CR" Style="{StaticResource GhostButton}"
                      IsEnabled="False" Padding="6,5" FontSize="10.5" Margin="0,0,4,0" Click="AllPriceOne_Click"
                      ToolTip="Set BaseCost to 1 for every car in the loaded working database."/>
              <Button x:Name="RevertPricesBtn" Grid.Column="1" Content="Revert prices" Style="{StaticResource GhostButton}"
                      IsEnabled="False" Padding="6,5" FontSize="10.5" Margin="4,0,0,0" Click="RevertPrices_Click"
                      ToolTip="Restore every BaseCost captured when this database was loaded."/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== CENTER: option cards ===== -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
        <StackPanel>

          <!-- ENGINE (full width) -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
              <Border Style="{StaticResource CardHeadStrip}">
                <Grid>
                  <TextBlock x:Name="EngCardTitle" Style="{StaticResource CardTitle}" Text="ENGINE" HorizontalAlignment="Left"/>
                  <ComboBox x:Name="ModeCombo" Width="128" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center"
                            SelectedIndex="0" SelectionChanged="Mode_Changed">
                    <ComboBoxItem>Engines</ComboBoxItem>
                    <ComboBoxItem>Motors</ComboBoxItem>
                  </ComboBox>
                </Grid>
              </Border>
              <StackPanel Margin="14,10,14,12">
                <Grid>
                  <TextBox x:Name="EngSearch" Style="{StaticResource Input}" TextChanged="EngSearch_Changed"/>
                  <TextBlock x:Name="EngSearchPh" Text="search engines: V10, Porsche, 2JZ, Diesel…"
                             Foreground="{StaticResource Dim}" IsHitTestVisible="False"
                             Margin="12,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel x:Name="MakeRow" Orientation="Horizontal" Margin="0,8,0,0">
                  <ComboBox x:Name="MakeFilter" Width="180" SelectionChanged="MakeFilter_Changed"/>
                  <ComboBox x:Name="TypeFilter" Width="150" Margin="8,0,0,0" SelectionChanged="MakeFilter_Changed"/>
                  <CheckBox x:Name="HideUsed" Content="hide already-added" Margin="14,0,0,0"
                            VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                </StackPanel>
                <ListBox x:Name="EngList" Style="{StaticResource DarkList}" Height="150" Margin="0,8,0,0"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="BtnSetStock" Grid.Column="0" Content="★  Set as STOCK engine" Style="{StaticResource PinkButton}" Click="SetStock_Click" Margin="0,0,6,0"/>
                  <Button x:Name="BtnAddSwap" Grid.Column="1" Content="＋  Add as swap" Style="{StaticResource PinkFilled}" Click="AddSwap_Click" Margin="6,0,0,0"/>
                </Grid>
                <Grid x:Name="EngBulkRow" Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="＋  Add all of make" Style="{StaticResource GhostButton}" Click="AddMake_Click" Margin="0,0,6,0"/>
                  <Button Grid.Column="1" Content="＋  Add EVERY engine" Style="{StaticResource GhostButton}" Click="AddAll_Click" Margin="6,0,0,0"/>
                </Grid>
                <Button x:Name="MotorBulkRow" Content="＋  Add EVERY motor as a swap option" Style="{StaticResource GhostButton}"
                        Margin="0,8,0,0" Visibility="Collapsed" Click="AddAllMotors_Click"/>
                <Button Content="⚡  Convert to Electric  —  highest-output motor" Style="{StaticResource PinkButton}"
                        Margin="0,8,0,0" Click="Electric_Click"
                        ToolTip="Swaps the selected car to a pure EV using the highest-output motor in the DB (Rimac Nevera on stock data). Removes the engine menu, fits the single-speed EV drivetrain. RWD/FWD upgrade options still work."/>
                <TextBlock x:Name="EngHint" Style="{StaticResource Hint}"
                           Text="“Set as STOCK” on an EV auto-converts it to combustion: copies the engine spec, drops the electric motor, fits the donor’s gearbox."/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- WHEELS & FITMENT (full width) -->
          <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <StackPanel>
              <Border Style="{StaticResource CardHeadStrip}"><TextBlock Style="{StaticResource CardTitle}" Text="WHEELS &amp; FITMENT"/></Border>
              <StackPanel Margin="14,10,14,12">
                <!-- Apply-to-body targets (Stock / widebody variants for the selected car) -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Apply to body" VerticalAlignment="Center"/>
                  <TabControl Grid.Column="1" x:Name="BodyTargets" Height="32" VerticalAlignment="Center"
                              Background="Transparent" BorderThickness="0" SelectionChanged="BodyTarget_Changed"/>
                </Grid>
                <!-- Rim sizes -->
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" x:Name="OptRims" Content="Rim sizes (inch)" IsChecked="True" VerticalAlignment="Top" Margin="0,4,0,0"
                            ToolTip="Shared front and rear wheel diameters in inches. Press + to add more. Blank boxes are skipped."/>
                  <StackPanel Grid.Column="1">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="front + rear" VerticalAlignment="Center"/>
                      <WrapPanel Grid.Column="1" x:Name="RFBoxes"/>
                      <Button Grid.Column="2" Content="＋" Style="{StaticResource GhostButton}" Padding="9,2" Margin="4,0,0,0" Click="AddRF" ToolTip="Add a shared rim-size box"/>
                    </Grid>
                  </StackPanel>
                </Grid>
                <!-- Tire widths (mm): front / rear, press + to add more per axle -->
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" x:Name="OptWidth" Content="Tire widths (mm)" IsChecked="True" VerticalAlignment="Top" Margin="0,4,0,0"
                            ToolTip="Absolute tread width in mm. Press + to add as many as you need per axle (up to 99). Blank boxes are skipped."/>
                  <StackPanel Grid.Column="1">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="front" VerticalAlignment="Center"/>
                      <WrapPanel Grid.Column="1" x:Name="WFBoxes"/>
                      <Button Grid.Column="2" Content="＋" Style="{StaticResource GhostButton}" Padding="9,2" Margin="4,0,0,0" Click="AddWF" ToolTip="Add a front tire-width box"/>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="rear" VerticalAlignment="Center"/>
                      <WrapPanel Grid.Column="1" x:Name="WRBoxes"/>
                      <Button Grid.Column="2" Content="＋" Style="{StaticResource GhostButton}" Padding="9,2" Margin="4,0,0,0" Click="AddWR" ToolTip="Add a rear tire-width box"/>
                    </Grid>
                  </StackPanel>
                </Grid>
                <!-- Tire profile / sidewall offsets: press + to add more (applied front & rear) -->
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" x:Name="OptAspect" Content="Tire profile (sidewall)" IsChecked="True" VerticalAlignment="Top" Margin="0,4,0,0"
                            ToolTip="Aspect-ratio offset. Negative = lower profile. Applied to front and rear. Press + to add as many as you need (up to 99)."/>
                  <WrapPanel Grid.Column="1" x:Name="SWBoxes" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Content="＋" Style="{StaticResource GhostButton}" Padding="9,2" Margin="4,0,0,0" VerticalAlignment="Top" Click="AddSW" ToolTip="Add a profile box"/>
                </Grid>
                <!-- Track width / offset (m): front / rear, press + to add more per axle -->
                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TrackExampleText" Foreground="{StaticResource Dim}"
                             FontSize="11.5" Margin="40,0,0,8" Visibility="Collapsed"
                             Text="Example offsets:  0.03  •  0.05  •  0.08  (start small)"/>
                  <CheckBox Grid.Row="1" Grid.Column="0" x:Name="OptTrack" Content="Track width / offset" IsChecked="True" VerticalAlignment="Top" Margin="0,4,0,0"
                            ToolTip="Track-spacer offset in metres. Press + to add as many as you need per axle (up to 99). Blank boxes are skipped."/>
                  <StackPanel Grid.Row="1" Grid.Column="1">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="front" VerticalAlignment="Center"/>
                      <WrapPanel Grid.Column="1" x:Name="OFBoxes"/>
                      <Button Grid.Column="2" Content="＋" Style="{StaticResource GhostButton}" Padding="9,2" Margin="4,0,0,0" Click="AddOF" ToolTip="Add a front offset box"/>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="rear" VerticalAlignment="Center"/>
                      <WrapPanel Grid.Column="1" x:Name="ORBoxes"/>
                      <Button Grid.Column="2" Content="＋" Style="{StaticResource GhostButton}" Padding="9,2" Margin="4,0,0,0" Click="AddOR" ToolTip="Add a rear offset box"/>
                    </Grid>
                  </StackPanel>
                </Grid>
                <!-- Reset -->
                <Button x:Name="BtnResetFitment" Content="↺  Reset fitment to stock (selected body)" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="ResetFitment_Click"
                        ToolTip="Removes all non-stock tire-width, tire-profile and track-width options from the ticked body/bodies."/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Two-column: DRIVETRAIN | TIRES -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
              <StackPanel>
                <Border Style="{StaticResource CardHeadStrip}"><TextBlock Style="{StaticResource CardTitle}" Text="DRIVETRAIN"/></Border>
                <StackPanel Margin="12,10,12,12">
                  <CheckBox x:Name="OptRWD" Content="Add RWD conversion option"/>
                  <CheckBox x:Name="OptFWD" Content="Add FWD conversion option" Margin="0,8,0,0"
                            ToolTip="Experimental — no stock car offers FWD as an upgrade, so handling may be odd. Uses a real FWD gearbox found in the loaded DB. Opt-in, non-stock upgrade."/>
                  <CheckBox x:Name="OptManual" Content="Manual transmission (EVs → geared)" Margin="0,8,0,0" IsEnabled="False"
                            ToolTip="Electric cars only (enabled when the selected car is an EV or has been swapped to electric this session): fits a 6-speed manual gearbox with its full transmission upgrade tree. Car stays electric but shifts real gears."/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
              <StackPanel>
                <Border Style="{StaticResource CardHeadStrip}"><TextBlock Style="{StaticResource CardTitle}" Text="TIRES &amp; STANCE"/></Border>
                <StackPanel Margin="12,10,12,12">
                  <CheckBox x:Name="OptWhite" Content="Whitewalls + vintage set" ToolTip="Sets TireBrandID = 4 and clones a curated 13-tire set (required for vintage compounds)."/>
                  <TextBlock Style="{StaticResource Hint}"
                             Text="Whitewall, vintage, vintage race, yellowwall + full grip. Brand swap is required for vintage compounds to load."/>
                  <CheckBox x:Name="OptFeTires" Content="Forza Edition tire set" Margin="0,10,0,0"
                            ToolTip="Adds the generic Forza Edition tire graphics and compounds as extra choices without deleting the car's existing tires."/>
                  <TextBlock Style="{StaticResource Hint}"
                             Text="Adds Street, Sport, Semi-Slick, Rally, Slick, Offroad, Snow and Drag variants using the game's _FE tire models."/>
                  <CheckBox x:Name="OptSlam" Content="Slam it — drift suspension" IsChecked="True" Margin="0,10,0,0"
                            ToolTip="Adds a Drift suspension from the car's stock suspension when missing, then lowers its ride-height range."/>
                  <CheckBox x:Name="OptLift" Content="Lift kit — rally suspension" Margin="0,8,0,0"
                            ToolTip="Adds a Rally suspension from the car's stock suspension when missing, then extends its slider 0.10 m above stock maximum."/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>

          <!-- APPLY (full width) -->
          <Border Style="{StaticResource CardBorder}" Margin="0,16,0,4">
            <StackPanel>
              <Border Style="{StaticResource CardHeadStrip}"><TextBlock Style="{StaticResource CardTitle}" Text="APPLY"/></Border>
              <StackPanel Margin="14,10,14,12">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="BestHandlingBtn" Grid.Column="0" Content="Apply enhanced handling" Style="{StaticResource PinkButton}"
                          IsEnabled="False" Margin="0,0,6,0" Click="BestHandling_Click"
                          ToolTip="Applies a calculated enhancement of the Lotus Exige WTA package and creates missing handling upgrades."/>
                  <Button x:Name="RevertHandlingBtn" Grid.Column="1" Content="Revert handling" Style="{StaticResource GhostButton}"
                          IsEnabled="False" Margin="6,0,0,0" Click="RevertHandling_Click"
                          ToolTip="Restores the values captured before Apply enhanced handling was first pressed for this car."/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                           Text="Lotus WTA geometry plus stronger game-valid grip, lower CG, mass-scaled springs/anti-roll and increased high-speed downforce. Missing upgrades are added; revert is per car and per session."/>
                <Button Content="⚙  APPLY changes to this car"
                        Style="{StaticResource PinkFilled}" Height="44" FontSize="13.5" Click="Apply_Click"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Engine adds apply instantly. This applies the checked sections. Then Export."/>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ===== RIGHT: activity log ===== -->
      <Border Grid.Column="2" Style="{StaticResource CardBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource CardHeadStrip}">
            <TextBlock Style="{StaticResource CardTitle}" Text="ACTIVITY LOG"/>
          </Border>
          <Border Grid.Row="1" Margin="10" Background="{StaticResource Card2}" CornerRadius="7">
            <RichTextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                         Foreground="{StaticResource Dim}" FontFamily="Consolas" FontSize="12" Padding="8,6"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
          </Border>
        </Grid>
      </Border>

    </Grid>
  </Grid>
</UserControl>
