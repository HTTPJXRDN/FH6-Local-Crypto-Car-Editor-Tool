<Window x:Class="FH6CarEditor.BatchEditConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FH6 Local Mod Tool - Batch Edit" Width="690" Height="440"
        MinWidth="590" MinHeight="400" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#FF1D1D1F" Foreground="#FFF4F4F6"
        Icon="/Assets/ICO/dbtool_icon.ico" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FFF4F4F6"/>
        <SolidColorBrush x:Key="Dim" Color="#FF9C9CA2"/>
        <SolidColorBrush x:Key="Line" Color="#FF3C3C40"/>
        <SolidColorBrush x:Key="Pink" Color="#FFE8175D"/>
        <LinearGradientBrush x:Key="AppGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF212123" Offset="0"/>
            <GradientStop Color="#FF191919" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF303034" Offset="0"/>
            <GradientStop Color="#FF29292C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PinkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFF2E70" Offset="0"/>
            <GradientStop Color="#FFE8175D" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#FF313135"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Pink}"/>
                                <Setter TargetName="Surface" Property="Background" Value="#FF38383D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfirmButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource PinkGrad}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource AppGrad}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#FF161618" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="DialogSection" Text="FH6 LOCAL MOD TOOL  /  BATCH EDIT" Foreground="{StaticResource Dim}"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="&#xE8BB;" Width="46" Height="34" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="{StaticResource Dim}" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" FontSize="10" Cursor="Hand"
                            ToolTip="Close" Click="Cancel_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource Pink}"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,24,26,14">
                    <TextBlock x:Name="DialogHeading" Text="Apply changes to selected cars?" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActionText" Foreground="{StaticResource Dim}"
                               FontSize="13" Margin="0,6,0,18" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource CardGrad}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="WHAT WILL HAPPEN" Foreground="{StaticResource Pink}"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,9"/>
                            <TextBlock x:Name="DetailsPrimary" Text="The current controls are used as the template. Rims, tire widths, profiles and track width use queued steps; existing upgrades stay, new values are sorted low-to-high, and duplicates are ignored."
                                       TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,0,0,9"/>
                            <TextBlock x:Name="DetailsSecondary" Text="Drift/rally suspension, drivetrain, tires, engines and selected power settings are included. Bodykit creation and bodykit targets are excluded."
                                       TextWrapping="Wrap" Foreground="{StaticResource Ink}" Margin="0,0,0,9"/>
                            <TextBlock x:Name="DetailsWarning" Text="If a car runs out of free upgrade IDs, additions already made to that car are kept. The remaining options for that car are skipped, the limit is logged, and the next car continues."
                                       TextWrapping="Wrap" Foreground="{StaticResource Dim}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,10,24,22">
                <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True"
                        Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="Apply to selected cars" Style="{StaticResource ConfirmButton}"
                        IsDefault="True" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
