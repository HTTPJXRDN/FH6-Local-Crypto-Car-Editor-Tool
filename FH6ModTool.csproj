<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FH6ModStudio</AssemblyName>
    <RootNamespace>FH6LocalCryptoTool</RootNamespace>
    <Product>FH6 Local Mod Tool</Product>
    <Title>FH6 Local Mod Tool</Title>
    <Description>Edit FH6 databases, cars, animations, and profile saves in one app.</Description>
    <Version>1.2.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ICO\dbtool_icon.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FH6LocalCrypto.Runtime">
      <HintPath>lib\FH6LocalCrypto.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="AnimationSwap\AclTools\forzatech_acl.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="forzatech_acl.dll" />
    <Content Include="AnimationSwap\AclTools\acl_compressor.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="acl_compressor.exe" />
    <Content Include="AnimationSwap\AclTools\LICENSE-ACL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="LICENSE-ACL.txt" />
    <Content Include="AnimationSwap\AclTools\LICENSE-RTM.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="LICENSE-RTM.txt" />
    <Content Include="AnimationSwap\AclTools\LICENSE-SJSON.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="LICENSE-SJSON.txt" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ICO\dbtool_icon.ico" />
    <Resource Include="Assets\Logo\FMLogo_trim.png" />
    <Resource Include="Assets\Logo\dbtool_icon.png" />
    <Resource Include="Assets\Logo\db_plain.png" />
    <EmbeddedResource Include="Assets\Reference\gamedbRC.stock.sqlite.gz"
                      LogicalName="FH6LocalCryptoTool.gamedbRC.stock.sqlite.gz" />
    <EmbeddedResource Include="AnimationSwap\donor_library.json" />
    <EmbeddedResource Include="AnimationSwap\stock_baseline.json" />
  </ItemGroup>
</Project>
