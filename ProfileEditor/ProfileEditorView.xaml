<UserControl x:Class="FH6ProfileEditor.ProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal">
  <UserControl.Resources>
    <!-- ==================================================================== -->
    <!--  Self-contained theme (a UserControl can't reach the Window's         -->
    <!--  resources at load time), copied from MainWindow / CarEditor so this  -->
    <!--  tab matches the rest of the app.                                     -->
    <!-- ==================================================================== -->

    <!-- ===== Palette ===== -->
    <SolidColorBrush x:Key="WinBg"    Color="#FF1D1D1F"/>
    <SolidColorBrush x:Key="Card"     Color="#FF2C2C2F"/>
    <SolidColorBrush x:Key="Card2"    Color="#FF232326"/>
    <SolidColorBrush x:Key="CardHead" Color="#FF333337"/>
    <SolidColorBrush x:Key="Line"     Color="#FF3C3C40"/>
    <SolidColorBrush x:Key="Hairline" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="Ink"      Color="#FFF4F4F6"/>
    <SolidColorBrush x:Key="Dim"      Color="#FF9C9CA2"/>
    <SolidColorBrush x:Key="Faint"    Color="#FF6E6E74"/>
    <SolidColorBrush x:Key="Pink"     Color="#FFE8175D"/>
    <SolidColorBrush x:Key="Pink2"    Color="#FFE8175D"/>

    <!-- ===== Gradients / effects ===== -->
    <LinearGradientBrush x:Key="AppGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF212123" Offset="0"/>
      <GradientStop Color="#FF191919" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF303034" Offset="0"/>
      <GradientStop Color="#FF29292C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHeadGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF3A3A3F" Offset="0"/>
      <GradientStop Color="#FF303034" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkGrad" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFF2E70" Offset="0"/>
      <GradientStop Color="#FFE8175D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkGradHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFF4A84" Offset="0"/>
      <GradientStop Color="#FFF02765" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PinkAccentLine" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FFE8175D" Offset="0"/>
      <GradientStop Color="#66E8175D" Offset="0.55"/>
      <GradientStop Color="#00E8175D" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                      Direction="270" Color="#FF000000" Opacity="0.36"/>

    <!-- ===== Card ===== -->
    <Style x:Key="PremiumCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardGrad}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <!-- ===== Dark ScrollBar (matches Car Editor) ===== -->
    <Style x:Key="ScrollNubHidden" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="#FF565660" CornerRadius="4" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="#FF6E6E7A"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="t" Property="Background" Value="{StaticResource Pink2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollNubHidden}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ===== Ghost button ===== -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#FF313135"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink2}"/>
                <Setter TargetName="b" Property="Background" Value="#FF38383D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Pink-outlined button ===== -->
    <Style x:Key="PinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Foreground" Value="{StaticResource Pink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Pink2}"/>
      <Setter Property="Background" Value="#22E8175D"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink}"/>
                <Setter TargetName="b" Property="Background" Value="#44E8175D"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF4A2530"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Pink filled button ===== -->
    <Style x:Key="PinkFilled" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource PinkGrad}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                  Color="#FFE8175D" Opacity="0.42"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource PinkGradHover}"/>
                <Setter TargetName="b" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                      Color="#FFE8175D" Opacity="0.68"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFC9124E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/>
                <Setter TargetName="b" Property="Effect" Value="{x:Null}"/>
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Input ===== -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Pink}"/>
      <Setter Property="Background" Value="#FF202023"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink}"/>
                <Setter TargetName="b" Property="Background" Value="#FF242428"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Dark DataGrid ===== -->
    <Style x:Key="PdCell" TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF44272F"/>
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PdColHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{StaticResource Pink}"/>
      <Setter Property="Background" Value="{StaticResource CardHead}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="PdRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#14FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PdGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource Card2}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowBackground" Value="Transparent"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="SelectionUnit" Value="Cell"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="AlternationCount" Value="2"/>
      <Setter Property="CellStyle" Value="{StaticResource PdCell}"/>
      <Setter Property="ColumnHeaderStyle" Value="{StaticResource PdColHeader}"/>
      <Setter Property="RowStyle" Value="{StaticResource PdRow}"/>
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource AppGrad}" TextElement.Foreground="{StaticResource Ink}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ===================== HEADER (matches other tabs) ===================== -->
    <Border Grid.Row="0" Background="{StaticResource CardHeadGrad}" Padding="20,11"
            BorderBrush="{StaticResource PinkAccentLine}" BorderThickness="0,0,0,2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock FontSize="22" FontWeight="Bold">
            <Run Text="FH6" Foreground="{StaticResource Pink}"/><Run Text=" Profile Editor"/>
          </TextBlock>
          <TextBlock x:Name="StatusLine" Text="no save loaded — click Load C_ProfileData to begin"
                     Foreground="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ViewOverviewBtn" Content="Overview" Style="{StaticResource PinkButton}" Click="ViewOverview_Click" Padding="12,6" Margin="0,0,5,0"/>
          <Button x:Name="ViewDbBtn" Content="Cars &amp; Data" Style="{StaticResource GhostButton}" Click="ViewDb_Click" Padding="12,6" Margin="0,0,5,0"/>
          <Button x:Name="ViewPropBtn" Content="Profile Values" Style="{StaticResource GhostButton}" Click="ViewProps_Click" Padding="12,6" Margin="0,0,5,0"/>
          <Button x:Name="ViewSaveBtn" Content="Save State" Style="{StaticResource GhostButton}" Click="ViewSave_Click" Padding="12,6" Margin="0,0,5,0"/>
          <Button x:Name="ViewCareerBtn" Content="Career" Style="{StaticResource GhostButton}" Click="ViewCareer_Click" Padding="12,6" Margin="0,0,14,0"/>
          <Button Content="📂  Load C_ProfileData" Style="{StaticResource GhostButton}" Click="Load_Click" Margin="0,0,8,0"/>
          <Button x:Name="SaveBtn" Content="⬇  Save edited…" Style="{StaticResource PinkFilled}" IsEnabled="False" Click="Save_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== BODY ===================== -->
    <Grid Grid.Row="1" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="120"/>
      </Grid.RowDefinitions>

      <!-- ===== Summary / plain-language help ===== -->
      <Border Grid.Row="0" Style="{StaticResource PremiumCard}" Margin="0,0,0,12" Padding="14,10">
        <StackPanel>
          <TextBlock x:Name="ViewHelp" Foreground="{StaticResource Ink}" FontSize="12.5" TextWrapping="Wrap"
                     Text="Load your C_ProfileData save to start. Everything you can change is grouped into the buttons above."/>
          <TextBlock x:Name="SummaryText" Foreground="{StaticResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                     Text=""/>
        </StackPanel>
      </Border>

      <!-- ===== View: Overview (friendly landing page) ===== -->
      <Border Grid.Row="1" x:Name="OverviewView" Style="{StaticResource PremiumCard}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="34" Padding="12,0">
            <TextBlock Text="OVERVIEW" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
            <StackPanel x:Name="OverviewPanel"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ===== View: Cars &amp; Data (SQLite tables) ===== -->
      <Grid Grid.Row="1" x:Name="DbBody" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="34" Padding="12,0">
              <TextBlock Text="TABLES" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <TextBox Grid.Row="1" x:Name="TableSearch" Style="{StaticResource Input}" Margin="10,10,10,0" Height="30"
                     TextChanged="TableSearch_Changed"/>
            <ListBox Grid.Row="2" x:Name="TableList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Ink}" Margin="6,8,6,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="TableList_Changed"/>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PremiumCard}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="34" Padding="12,0">
              <Grid>
                <TextBlock x:Name="GridTitle" Text="pick a table on the left" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="GridHint" Text="double-click a cell to edit" Foreground="{StaticResource Faint}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <DataGrid Grid.Row="1" x:Name="RowGrid" Style="{StaticResource PdGrid}" Margin="8"
                      CellEditEnding="RowGrid_CellEditEnding"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== View: Profile Values (typed CPropertyTree) ===== -->
      <Border Grid.Row="1" x:Name="PropView" Style="{StaticResource PremiumCard}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="34" Padding="12,0">
            <Grid>
              <TextBlock x:Name="PropTitle" Text="PROFILE VALUES" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="12"
                         VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <TextBlock Text="double-click a value to edit" Foreground="{StaticResource Faint}" FontSize="11"
                         VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
          </Border>
          <TextBox Grid.Row="1" x:Name="PropSearch" Style="{StaticResource Input}" Margin="8,8,8,0" Height="30"
                   TextChanged="PropSearch_Changed"/>
          <DataGrid Grid.Row="2" x:Name="PropGrid" Style="{StaticResource PdGrid}" Margin="8"
                    CellEditEnding="PropGrid_CellEditEnding"/>
        </Grid>
      </Border>

      <!-- ===== View: Save State (BXML) ===== -->
      <Grid Grid.Row="1" x:Name="SaveView" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Margin="0,0,12,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="34" Padding="12,0">
              <Grid>
                <TextBlock x:Name="SaveTitle" Text="TEXT VALUES" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="double-click the Text column to edit" Foreground="{StaticResource Faint}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <TextBox Grid.Row="1" x:Name="StringSearch" Style="{StaticResource Input}" Margin="8,8,8,0" Height="30"
                     TextChanged="StringSearch_Changed"/>
            <DataGrid Grid.Row="2" x:Name="StringGrid" Style="{StaticResource PdGrid}" Margin="8"
                      CellEditEnding="StringGrid_CellEditEnding"/>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PremiumCard}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="34" Padding="12,0">
              <TextBlock Text="STRUCTURE (read-only preview)" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </Border>
            <Border Grid.Row="1" Background="{StaticResource Card2}" CornerRadius="0,0,10,10" Margin="1,0,1,1">
              <RichTextBox x:Name="XmlPreview" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                           Foreground="{StaticResource Dim}" FontFamily="Consolas" FontSize="12" Padding="10,8"
                           IsUndoEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <FlowDocument PagePadding="0" LineHeight="18"/>
              </RichTextBox>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== View: Career (binary records) ===== -->
      <Border Grid.Row="1" x:Name="CareerView" Style="{StaticResource PremiumCard}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="34" Padding="12,0">
            <TextBlock x:Name="CareerTitle" Text="CAREER RECORDS" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
          </Border>
          <Border Grid.Row="1" Background="#FF202023" Padding="12,10" Margin="1,0,1,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Account ID (XUID):" Foreground="{StaticResource Dim}" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,10,0"/>
              <TextBox x:Name="XuidBox" Style="{StaticResource Input}" Width="230" Height="32" VerticalAlignment="Center"/>
              <Button x:Name="XuidApplyBtn" Content="Apply" Style="{StaticResource PinkButton}" Click="ApplyXuid_Click"
                      Padding="16,6" Margin="10,0,0,0" IsEnabled="False"/>
              <TextBlock x:Name="XuidHint" Text="the Xbox account this save belongs to" Foreground="{StaticResource Faint}" FontSize="11"
                         VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
          </Border>
          <DataGrid Grid.Row="2" x:Name="CareerGrid" Style="{StaticResource PdGrid}" Margin="8" IsReadOnly="True"/>
        </Grid>
      </Border>

      <!-- ===== SQL runner (Cars &amp; Data only) ===== -->
      <Border Grid.Row="2" x:Name="SqlCard" Style="{StaticResource PremiumCard}" Margin="0,12,0,12" Padding="12,10" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Advanced — type an SQL command to search or bulk-edit (e.g. UPDATE Career_Garage SET …). Leave this alone if you're not sure."
                     Foreground="{StaticResource Dim}" FontSize="11.5" Margin="2,0,0,6"/>
          <TextBox Grid.Row="1" Grid.Column="0" x:Name="SqlBox" Style="{StaticResource Input}" Height="50"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
          <Button Grid.Row="1" Grid.Column="1" Content="▶  Run" Style="{StaticResource PinkButton}"
                  VerticalAlignment="Stretch" Margin="10,0,0,0" Padding="18,0" Click="RunSql_Click"/>
        </Grid>
      </Border>

      <!-- ===== Activity log ===== -->
      <Border Grid.Row="3" Style="{StaticResource PremiumCard}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{StaticResource CardHead}" CornerRadius="10,10,0,0" Height="30" Padding="12,0">
            <TextBlock Text="ACTIVITY LOG" Foreground="{StaticResource Pink}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
          </Border>
          <Border Grid.Row="1" Background="{StaticResource Card2}" CornerRadius="0,0,10,10" Margin="1,0,1,1">
            <RichTextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                         Foreground="{StaticResource Dim}" FontFamily="Consolas" FontSize="12" Padding="10,8"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
