<Window x:Class="FH6LocalCryptoTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ce="clr-namespace:FH6CarEditor"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FH6 Local Crypto Tool" Height="840" Width="1000"
        MinHeight="520" MinWidth="560"
        Background="#FF1D1D1F"
        Icon="/Assets/ICO/dbtool_icon.ico"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="WinBg"  Color="#FF1D1D1F"/>
        <SolidColorBrush x:Key="Card"   Color="#FF2C2C2F"/>
        <SolidColorBrush x:Key="Card2"  Color="#FF232326"/>
        <SolidColorBrush x:Key="CardHead" Color="#FF333337"/>
        <SolidColorBrush x:Key="Line"   Color="#FF3C3C40"/>
        <SolidColorBrush x:Key="Hairline" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="Ink"    Color="#FFF4F4F6"/>
        <SolidColorBrush x:Key="Dim"    Color="#FF9C9CA2"/>
        <SolidColorBrush x:Key="Faint"  Color="#FF6E6E74"/>
        <SolidColorBrush x:Key="Pink"   Color="#FFE8175D"/>
        <SolidColorBrush x:Key="Pink2"  Color="#FFE8175D"/>

        <LinearGradientBrush x:Key="AppGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF212123" Offset="0"/>
            <GradientStop Color="#FF191919" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF303034" Offset="0"/>
            <GradientStop Color="#FF29292C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardHeadGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF3A3A3F" Offset="0"/>
            <GradientStop Color="#FF303034" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PinkGrad" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFF2E70" Offset="0"/>
            <GradientStop Color="#FFE8175D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PinkGradHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFF4A84" Offset="0"/>
            <GradientStop Color="#FFF02765" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PinkAccentLine" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFE8175D" Offset="0"/>
            <GradientStop Color="#66E8175D" Offset="0.55"/>
            <GradientStop Color="#00E8175D" Offset="1"/>
        </LinearGradientBrush>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3"
                          Direction="270" Color="#FF000000" Opacity="0.36"/>

        <Style x:Key="PremiumCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardGrad}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- ===== Base text ===== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource AppGrad}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Background" Value="#FF18181B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="{TemplateBinding Background}" Cursor="Hand">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="2"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <Border x:Name="SelectedLine" Grid.Row="1" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter Property="Background" Value="#FF28282C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Pink}"/>
                                <Setter Property="Background" Value="#FF111113"/>
                                <Setter TargetName="SelectedLine" Property="Background" Value="{StaticResource Pink}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Ghost button (Clear) ===== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#FF313135"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink2}"/>
                                <Setter TargetName="b" Property="Background" Value="#FF38383D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Pink-outlined button (Browse) ===== -->
        <Style x:Key="PinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{StaticResource Pink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Pink2}"/>
            <Setter Property="Background" Value="#22E8175D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink}"/>
                                <Setter TargetName="b" Property="Background" Value="#44E8175D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF4A2530"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinkFilled" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PinkGrad}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0"
                                                  Color="#FFE8175D" Opacity="0.42"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PinkGradHover}"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                                          Color="#FFE8175D" Opacity="0.68"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFC9124E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Line}"/>
                                <Setter TargetName="b" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Dark ComboBox ===== -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="#FF202023"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem,
                                        RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        TextElement.Foreground="{StaticResource Ink}"
                                        Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <Viewbox Grid.Column="1" Width="14" Height="14" Margin="0,0,12,0">
                                    <Path Data="M6 9 L12 15 L18 9" Stroke="{StaticResource Pink}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{StaticResource Ink}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF44272F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                       RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}"
                                        BorderThickness="1" CornerRadius="7" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Pink}"/>
            <Setter Property="Background" Value="#FF202023"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Pink}"/>
                                <Setter TargetName="b" Property="Background" Value="#FF242428"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF34343A"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF2A2A2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Pink}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFC9124E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Pink CheckBox ===== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="5"
                                    Background="Transparent" BorderBrush="{StaticResource Line}"
                                    BorderThickness="2" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14">
                                    <Path x:Name="tick" Data="M4 8 L7 11 L12 4" Stroke="White"
                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                </Viewbox>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Pink}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Pink}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Pink2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource AppGrad}"
            BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="34" Background="#FF161618">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                      ToolTip="Minimize" Click="MinimizeButton_Click"/>
              <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                      ToolTip="Maximize" Click="MaximizeButton_Click"/>
              <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                      ToolTip="Close" Click="CloseButton_Click"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Height="2" Background="{StaticResource PinkAccentLine}"/>

    <TabControl Grid.Row="2" Background="{StaticResource AppGrad}" BorderThickness="0">
      <TabItem Header="Local Crypto">
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Margin="-24,-18,-24,18"
                Background="{StaticResource CardHeadGrad}" Padding="20,11"
                BorderBrush="{StaticResource PinkAccentLine}" BorderThickness="0,0,0,2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="Bold">
                    <Run Text="FH6" Foreground="{StaticResource Pink}"/><Run Text=" Local Crypto Tool"/>
                </TextBlock>
                <TextBlock Text="Drag a file onto a zone below. No commands needed."
                           Foreground="{StaticResource Dim}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
            <Image Grid.Column="1" Source="/Assets/Logo/FMLogo_trim.png" Height="46"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        </Border>

        <!-- ===== Main drop zone ===== -->
        <Border x:Name="DropBorder" Grid.Row="1" Height="232" CornerRadius="12"
                BorderBrush="{StaticResource Line}" BorderThickness="1"
                AllowDrop="True"
                DragEnter="Drop_DragEnter" DragOver="Drop_DragOver"
                DragLeave="Drop_DragLeave" Drop="Drop_Drop">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF2F2F33" Offset="0"/>
                    <GradientStop Color="#FF262629" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Rectangle x:Name="DropDash" RadiusX="11" RadiusY="11" Margin="1"
                           Stroke="{StaticResource Pink2}" StrokeThickness="1.6"
                           StrokeDashArray="5 4" StrokeDashCap="Round" Fill="Transparent"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Assets/Logo/dbtool_icon.png" Width="42" Height="42"
                           HorizontalAlignment="Center" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="DropTitle" Text="Drop a file here" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Pink}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Foreground="{StaticResource Dim}" FontSize="12.5" VerticalAlignment="Center">
                            <Run Text=".slt" Foreground="{StaticResource Ink}"/><Run Text="  →  decrypt to .sqlite"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Pink}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Foreground="{StaticResource Dim}" FontSize="12.5" VerticalAlignment="Center">
                            <Run Text=".sqlite" Foreground="{StaticResource Ink}"/><Run Text="  →  re-encrypt to .slt (uses the template below)"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Pink}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Foreground="{StaticResource Dim}" FontSize="12.5" VerticalAlignment="Center">
                            <Run Text=".zip" Foreground="{StaticResource Ink}"/><Run Text="  →  decrypt and extract (General key)"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource Pink}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Foreground="{StaticResource Dim}" FontSize="12.5" VerticalAlignment="Center">
                            <Run Text="asset" Foreground="{StaticResource Ink}"/><Run Text="  ↔  decrypt/re-encrypt text assets — .ini, AnimResourceConfig… (General key)"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="StagedText" Visibility="Collapsed" HorizontalAlignment="Center"
                               Foreground="{StaticResource Pink}" FontSize="11.5" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Button Content="Decrypt" Style="{StaticResource PinkButton}" MinWidth="104" Padding="14,5"
                                Margin="0,0,10,0" Click="Decrypt_Click"/>
                        <Button Content="Re-encrypt" Style="{StaticResource PinkFilled}" MinWidth="104" Padding="14,5"
                                Click="ReEncrypt_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Template row ===== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="DB template:" VerticalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="13.5"/>
            <Border Grid.Column="1" Background="#FF202023" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="12,9" Height="38">
                <TextBlock x:Name="TemplateText" Text="(auto: the last .slt you decrypted)"
                           Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
            <Button Grid.Column="2" Content="Browse…" Style="{StaticResource PinkButton}" Click="BrowseTemplate_Click"/>
        </Grid>

        <!-- ===== Output folder row ===== -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Output folder:" VerticalAlignment="Center" Foreground="{StaticResource Dim}" FontSize="13.5"/>
            <Border Grid.Column="1" Background="#FF202023" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" Padding="12,9" Height="38">
                <TextBlock x:Name="OutputText" Text="(same folder as the dropped file)"
                           Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
            <Button Grid.Column="2" Content="Clear" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ClearOutput_Click"/>
            <Button Grid.Column="3" Content="Browse…" Style="{StaticResource PinkButton}" Click="BrowseOutput_Click"/>
        </Grid>

        <!-- ===== Key + option row ===== -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Key:" VerticalAlignment="Center" Foreground="{StaticResource Dim}" Margin="0,0,10,0" FontSize="13.5"/>
            <ComboBox x:Name="KeyCombo" Grid.Column="1" Width="170" VerticalAlignment="Center"/>
            <CheckBox x:Name="OpenFolderCheck" Grid.Column="3" Content="Open folder when done"
                      FontSize="13.5" VerticalAlignment="Center" IsChecked="True"/>
        </Grid>

        <!-- ===== Merge zone ===== -->
        <Border x:Name="MergeBorder" Grid.Row="5" Height="86" Margin="0,16,0,0"
                Style="{StaticResource PremiumCard}" AllowDrop="True"
                DragEnter="Drop_DragEnter" DragOver="Drop_DragOver"
                DragLeave="Drop_DragLeave" Drop="Merge_Drop">
            <Grid Margin="18,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="34" Height="34" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Path Data="M4 4 A8 3 0 1 0 20 4 A8 3 0 1 0 4 4 Z M4 4 V20 A8 3 0 0 0 20 20 V4 M4 9.3 A8 3 0 0 0 20 9.3 M4 14.7 A8 3 0 0 0 20 14.7"
                          Stroke="{StaticResource Pink}" StrokeThickness="1.5" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Run Text="Optional:" Foreground="{StaticResource Pink}" FontWeight="SemiBold"/><Run Text="  drop an overlay .sqlite or .sql here, then click Merge" Foreground="{StaticResource Dim}"/>
                    </TextBlock>
                    <TextBlock x:Name="MergeStagedText" Visibility="Collapsed" Foreground="{StaticResource Pink}"
                               FontSize="12.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <CheckBox x:Name="AddOnlyCheck" Content="Add only — never overwrite my rows"
                              FontSize="12.5" Margin="0,6,0,0" IsChecked="True"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Merge" Style="{StaticResource PinkButton}" MinWidth="104"
                        VerticalAlignment="Center" Click="Merge_Click"/>
            </Grid>
        </Border>

        <!-- ===== Log ===== -->
        <Border Grid.Row="6" Margin="0,16,0,0" Style="{StaticResource PremiumCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- header -->
                <Grid Grid.Row="0" Margin="16,12,16,0">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="LOG" Foreground="{StaticResource Pink}" FontWeight="Bold"
                                   FontSize="13" Margin="0,0,0,6"/>
                        <Rectangle Height="2" Width="34" Fill="{StaticResource Pink}" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="4" Click="ClearLog_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Clear log" Foreground="{StaticResource Pink}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <Viewbox Width="14" Height="14" Margin="6,0,0,0">
                                            <Path Data="M4 7 H20 M9 7 V5 A1 1 0 0 1 10 4 H14 A1 1 0 0 1 15 5 V7 M6 7 V20 A1 1 0 0 0 7 21 H17 A1 1 0 0 0 18 20 V7 M10 11 V17 M14 11 V17"
                                                  Stroke="{StaticResource Pink}" StrokeThickness="1.6" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <!-- body -->
                <Border Grid.Row="1" Background="{StaticResource Card2}" CornerRadius="8" Margin="10,10,10,10">
                    <RichTextBox x:Name="LogBox" Background="Transparent" Foreground="{StaticResource Dim}"
                                 BorderThickness="0" IsReadOnly="True" Padding="10,8"
                                 FontFamily="Consolas" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="7" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                    <Path Data="M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 Z M7.5 12.4 L10.6 15.5 L16.5 8.8"
                          Stroke="{StaticResource Pink}" StrokeThickness="1.6" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Viewbox>
                <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource Dim}"
                           VerticalAlignment="Center" FontSize="13.5"/>
            </StackPanel>
        </Border>
    </Grid>
      </TabItem>
      <TabItem Header="Save Swap">
        <Grid Margin="28,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Margin="-28,-24,-28,24"
                  Background="{StaticResource CardHeadGrad}" Padding="20,11"
                  BorderBrush="{StaticResource PinkAccentLine}" BorderThickness="0,0,0,2">
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="22" FontWeight="Bold"><Run Text="FH6" Foreground="{StaticResource Pink}"/><Run Text=" Save Swap"/></TextBlock>
              <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap"
                         Text="Copies donor progress while retaining the target account identity and container framing — originals are never overwritten."/>
            </StackPanel>
          </Border>
          <TextBlock Grid.Row="1" Text="DONOR SAVE (progress to copy)" Foreground="{StaticResource Pink}" FontWeight="Bold" Margin="0,0,0,7"/>
          <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="DonorSaveText" Grid.Column="0" Height="40" Style="{StaticResource Input}"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource PinkButton}" Margin="10,0,0,0" Click="BrowseDonorSave_Click"/>
          </Grid>
          <TextBlock Grid.Row="3" Text="TARGET SAVE (your account/container)" Foreground="{StaticResource Pink}" FontWeight="Bold" Margin="0,0,0,7"/>
          <Grid Grid.Row="4" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TargetSaveText" Grid.Column="0" Height="40" Style="{StaticResource Input}"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource PinkButton}" Margin="10,0,0,0" Click="BrowseTargetSave_Click"/>
          </Grid>
          <StackPanel Grid.Row="5">
            <Button Content="Build Swapped Save" Style="{StaticResource PinkFilled}" Height="44" HorizontalAlignment="Left" Padding="24,0" Click="SwapSave_Click"/>
            <Border Style="{StaticResource PremiumCard}" Margin="0,22,0,0" Padding="16">
              <TextBlock x:Name="SwapStatusText" Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                         Text="Choose two C_ProfileData files. The result is written beside the target with a .swapped name; the original is untouched."/>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Car Editor">
        <ce:CarEditorView/>
      </TabItem>
    </TabControl>
        <TextBlock Grid.Row="2" Panel.ZIndex="20" Text="V1.0.0"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,10,15,0" Foreground="{StaticResource Faint}"
                   FontSize="10.5" FontWeight="SemiBold" IsHitTestVisible="False"/>
      </Grid>
    </Border>
</Window>
